# ── Supabase (required for multi-user auth and data storage) ──────────────────
# Create a free project at https://supabase.com
# Find these values in: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — server-side only, NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── AI Providers ───────────────────────────────────────────────────────────────
# Optional — leave empty to use the offline rule-based chatbot fallback.
# Recommended: Llama 3.3 70B Versatile via Groq (free tier, blazing fast).
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — HuggingFace Inference API token for semantic KB search.
# Enables embedding-based retrieval (sentence-transformers/all-MiniLM-L6-v2)
# as a higher-quality offline fallback when GROQ_API_KEY is not set.
# Free tier: https://huggingface.co/settings/tokens
HF_TOKEN=

# Legacy / future providers (unused right now)
OPENAI_API_KEY=
GEMINI_API_KEY=
